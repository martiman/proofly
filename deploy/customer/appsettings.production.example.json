{
  "ConnectionStrings": {
    "Proofly": "Host=db.internal;Port=5432;Database=proofly;Username=proofly;SSL Mode=Require"
  },
  "Evidence": { "Directory": "/var/lib/proofly/evidence" },
  "Auth": {
    "Mode": "Oidc",
    "Oidc": { "Authority": "https://idp.example.com/realms/proofly", "Audience": "proofly-api" }
  },
  "Cors": { "AllowedOrigins": [ "https://proofly.example.com" ] },
  "Database": { "MigrateOnStartup": false },
  "Observability": {
    "Metrics": { "Enabled": false, "AllowedAddresses": [ "127.0.0.1", "::1" ], "Port": null, "ListenerPrefix": "http://127.0.0.1:9465/" }
  },
  "Urls": "http://127.0.0.1:8080"
}
