# /etc/proofly/proofly.env  (mode 0640 root:proofly). Never commit real values.
# The password is not in appsettings: keep it only here / in the Windows service environment.
ConnectionStrings__Proofly=Host=db.internal;Port=5432;Database=proofly;Username=proofly;Password=CHANGE_ME;SSL Mode=Require
Evidence__Directory=/var/lib/proofly/evidence
Auth__Mode=Oidc
Auth__Oidc__Authority=https://idp.example.com/realms/proofly
Auth__Oidc__Audience=proofly-api
ASPNETCORE_URLS=http://127.0.0.1:8080
Observability__Metrics__Enabled=false
