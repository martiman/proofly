# Copy to .env.local (gitignored). Dev only; never commit a token.
# Base URL of the API as the browser sees it. Default /api/v1 (proxied by Vite to PROOFLY_API_PORT / PROOFLY_API_URL).
# VITE_API_BASE_URL=/api/v1
# Local-mode bearer token printed by scripts/dev-backend.sh (.dev/tokens.txt). Alternative: setDevToken() in the console.
# VITE_DEV_TOKEN=
# Dev server port and API target for the proxy.
# WEB_PORT=5199
# PROOFLY_API_PORT=5080
